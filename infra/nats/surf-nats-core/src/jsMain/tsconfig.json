{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": true,
    "rootDirs": ["resources", "../../build/dist/js/productionLibrary"],
    "paths": {
      "@bufbuild/protobuf": ["../../../build/js/node_modules/@bufbuild/protobuf"]
    }
  },
  "include": ["resources/*.mts", "resources/*.mjs"]
}
