/** Collects this sequence into an unmodifiable fastutil {{NAME}} set. */
inline fun Sequence<{{NAME}}>.to{{NAME}}Set(): {{NAME}}Set {
    val it = iterator()
    if (!it.hasNext()) return empty{{NAME}}Set()
    val first = it.next()
    if (!it.hasNext()) return {{LOWER_NAME}}SetOf(first)
    val set = mutable{{NAME}}SetOf()
    set.add(first)
    while (it.hasNext()) set.add(it.next())
    return set.freeze()
}

