@@ -0,0 +1,58 @@
+package me.lucko.luckperms.minestom.dependencies;
+
+import java.lang.instrument.Instrumentation;
+import org.jetbrains.annotations.NotNull;
+import org.jetbrains.annotations.Nullable;
+
+/**
+ * Captures the {@link Instrumentation} instance that LuckPerms uses to load its runtime
+ * dependencies.
+ *
+ * <p>Unlike the other platforms, LuckPerms is embedded as a plain library on Minestom, so it is
+ * loaded by the system class loader rather than by a class loader LuckPerms owns. Appending to the
+ * system class loader is only possible through the instrumentation API, and the JVM only hands that
+ * out to an agent - so the host application has to install one. Either:</p>
+ *
+ * <ul>
+ * <li>add {@code Launcher-Agent-Class: me.lucko.luckperms.minestom.dependencies.LuckPermsAgent} to
+ * the manifest of the executable jar (works out of the box with {@code java -jar}), or</li>
+ * <li>start the server with {@code -javaagent:<jar>}, pointing at a jar containing this class.</li>
+ * </ul>
+ *
+ * <p>Applications that run LuckPerms inside a class loader they control don't need an agent at all
+ * and should pass their own appender to
+ * {@link me.lucko.luckperms.minestom.LuckPermsMinestom.Builder#classPathAppender} instead.</p>
+ */
+public final class LuckPermsAgent {
+
+    private static volatile @Nullable Instrumentation instrumentation;
+
+    private LuckPermsAgent() {
+
+    }
+
+    /**
+     * Called by the JVM when this class is used as a {@code -javaagent}.
+     */
+    public static void premain(@Nullable String args, @NotNull Instrumentation instrumentation) {
+        LuckPermsAgent.instrumentation = instrumentation;
+    }
+
+    /**
+     * Called by the JVM when this class is declared as the {@code Launcher-Agent-Class} of an
+     * executable jar, or when the agent is attached to a running JVM.
+     */
+    public static void agentmain(@Nullable String args, @NotNull Instrumentation instrumentation) {
+        LuckPermsAgent.instrumentation = instrumentation;
+    }
+
+    /**
+     * Gets the captured instrumentation instance.
+     *
+     * @return the instrumentation instance, or null if no agent has been installed
+     */
+    public static @Nullable Instrumentation getInstrumentation() {
+        return instrumentation;
+    }
+
+}
