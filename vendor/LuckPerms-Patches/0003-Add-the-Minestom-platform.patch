From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: surf-api <dev@slne.dev>
Date: Tue, 3 Nov 2026 11:05:23 +0100
Subject: [PATCH] Add the Minestom platform


diff --git a/api/src/main/java/net/luckperms/api/platform/Platform.java b/api/src/main/java/net/luckperms/api/platform/Platform.java
index fe0e4fbf77308fdcda19fef634a75cfea5051115..d4103127a3065c217abf26d9e4c658d57a0486d2 100644
