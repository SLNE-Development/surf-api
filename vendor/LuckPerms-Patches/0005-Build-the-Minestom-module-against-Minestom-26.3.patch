Subject: [PATCH] Build the Minestom module against Minestom 26.3


diff --git a/minestom/build.gradle b/minestom/build.gradle
index 15b8b389203a41cb8823da6e5d3d874f8f06817d..b5c0b79fd74882db11fb7e574a5b68461fb65a92 100644
--- a/minestom/build.gradle
+++ b/minestom/build.gradle
@@ -11,11 +11,16 @@ tasks.withType(JavaCompile).configureEach {
 }
 
 repositories {
+    // experimental 26.3 builds
+    maven {
+        url "https://central.sonatype.com/repository/maven-snapshots/"
+        mavenContent { snapshotsOnly() }
+    }
     mavenCentral()
 }
 
 dependencies {
-    var minestom = "net.minestom:minestom:2026.07.22-26.2"
+    var minestom = "net.minestom:minestom:26_3-SNAPSHOT"
 
     api(project(":common")) {
         // exclude default config providers as they are inaccessible from the minestom module anyway
