From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: twisti-dev <twisti@slne.dev>
Date: Mon, 3 Aug 2026 23:47:24 +0200
Subject: [PATCH] Make the runtime dependency manager work on Minestom

LuckPerms is embedded as a plain library on Minestom, so it is loaded by the
system class loader and its own classes are not relocated at build time. Both
facts broke the dependency manager, which was stubbed out with no-ops.

 - append downloaded jars to the system class loader via the instrumentation
   API, which requires the host application to install LuckPermsAgent
 - let embedders supply their own ClassPathAppender via the builder
 - use the real DependencyManagerImpl with the usual global dependencies,
   except adventure, which Minestom itself provides
 - publish reference-relocated (shaded) jars for the common and minestom
   modules, so LuckPerms' own classes refer to the me.lucko.luckperms.lib
   packages that the downloaded dependencies are relocated into
 - stop shipping okhttp, okio, caffeine, byte-buddy, event-api and configurate
   as dependencies of the minestom library - they are downloaded at runtime
   instead, keeping them off the host application's class path

diff --git a/common/build.gradle b/common/build.gradle
index c5be9150ca99ea6d2a031f91f8faf0d0ea5fbb95..0ad79b68c58fd68595bca22f953a8f2e9b44afaa 100644
--- a/common/build.gradle
+++ b/common/build.gradle
@@ -2,6 +2,38 @@ plugins {
     id("java-library")
     id("jacoco")
     alias(libs.plugins.blossom)
+    alias(libs.plugins.shadow)
+}
+
+// Rewrite references to the libraries the dependency manager downloads at runtime, so they match
+// the relocated jars it produces (see the Dependency enum). Only this module's own classes are
+// shaded - no dependencies are bundled. Compilation and tests keep using the plain jar.
+shadowJar {
+    archiveClassifier = 'shaded'
+    configurations = []
+
+    relocate 'net.kyori.event', 'me.lucko.luckperms.lib.eventbus'
+    relocate 'com.github.benmanes.caffeine', 'me.lucko.luckperms.lib.caffeine'
+    relocate 'okio', 'me.lucko.luckperms.lib.okio'
+    relocate 'okhttp3', 'me.lucko.luckperms.lib.okhttp3'
+    relocate 'net.bytebuddy', 'me.lucko.luckperms.lib.bytebuddy'
+    relocate 'org.mariadb.jdbc', 'me.lucko.luckperms.lib.mariadb'
+    relocate 'com.mysql', 'me.lucko.luckperms.lib.mysql'
+    relocate 'org.postgresql', 'me.lucko.luckperms.lib.postgresql'
+    relocate 'com.zaxxer.hikari', 'me.lucko.luckperms.lib.hikari'
+    relocate 'com.mongodb', 'me.lucko.luckperms.lib.mongodb'
+    relocate 'org.bson', 'me.lucko.luckperms.lib.bson'
+    relocate 'redis.clients.jedis', 'me.lucko.luckperms.lib.jedis'
+    relocate 'io.nats.client', 'me.lucko.luckperms.lib.nats'
+    relocate 'com.rabbitmq', 'me.lucko.luckperms.lib.rabbitmq'
+    relocate 'org.apache.commons.pool2', 'me.lucko.luckperms.lib.commonspool2'
+    relocate 'ninja.leaping.configurate', 'me.lucko.luckperms.lib.configurate'
+    relocate 'org.yaml.snakeyaml', 'me.lucko.luckperms.lib.yaml'
+}
+
+configurations.runtimeElements.outgoing {
+    artifacts.clear()
+    artifact(shadowJar)
 }
 
 // Adventure 5 requires Java 21
