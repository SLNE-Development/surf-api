+++ b/minestom/src/main/java/me/lucko/luckperms/minestom/dependencies/InstrumentationClassPathAppender.java
@@ -0,0 +1,56 @@
+package me.lucko.luckperms.minestom.dependencies;
+
+import java.io.IOException;
+import java.io.UncheckedIOException;
+import java.lang.instrument.Instrumentation;
+import java.nio.file.Path;
+import java.util.jar.JarFile;
+import me.lucko.luckperms.common.plugin.classpath.ClassPathAppender;
+import org.jetbrains.annotations.NotNull;
+
+/**
+ * A {@link ClassPathAppender} that adds jars to the system class loader using the instrumentation
+ * API, which is the only supported way of extending the system class path at runtime.
+ */
+public final class InstrumentationClassPathAppender implements ClassPathAppender {
+
+    /**
+     * Creates an appender from the {@link Instrumentation} instance an agent has made available.
+     *
+     * <p>Without an appender LuckPerms cannot load its core libraries (caffeine, okhttp, the event
+     * bus, ...), so a missing agent is a configuration error rather than a degraded mode.</p>
+     *
+     * @return the appender
+     * @throws IllegalStateException if no agent is installed
+     */
+    public static @NotNull ClassPathAppender create() {
+        Instrumentation instrumentation = LuckPermsAgent.getInstrumentation();
+        if (instrumentation == null) {
+            throw new IllegalStateException("LuckPerms cannot load its runtime dependencies: no agent " +
+                    "has made the instrumentation API available and no ClassPathAppender was supplied. " +
+                    "Either add 'Launcher-Agent-Class: " + LuckPermsAgent.class.getName() + "' to the " +
+                    "manifest of your application jar, start the server with '-javaagent:<your-jar>', " +
+                    "or supply your own ClassPathAppender via LuckPermsMinestom.Builder#classPathAppender.");
+        }
+
+        return new InstrumentationClassPathAppender(instrumentation);
+    }
+
+    private final @NotNull Instrumentation instrumentation;
+
+    private InstrumentationClassPathAppender(@NotNull Instrumentation instrumentation) {
+        this.instrumentation = instrumentation;
+    }
+
+    @Override
+    public void addJarToClasspath(Path file) {
+        try {
+            // the JVM takes ownership of the JarFile and may keep it open for the rest of the
+            // process lifetime, so it must not be closed here
+            this.instrumentation.appendToSystemClassLoaderSearch(new JarFile(file.toFile()));
+        } catch (IOException e) {
+            throw new UncheckedIOException("Unable to add " + file + " to the system class path", e);
+        }
+    }
+
+}
